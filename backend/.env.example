# Plaid API credentials — obtain from https://dashboard.plaid.com
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here
PLAID_ENV=sandbox

# Encryption key for access_token storage (generate a strong 256-bit key)
# openssl rand -hex 32
ENCRYPTION_KEY=replace_with_a_secure_256_bit_hex_key

# Server
PORT=3001

# Allowed origins (comma-separated for CORS)
ALLOWED_ORIGINS=http://localhost:3000
